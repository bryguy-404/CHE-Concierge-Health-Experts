---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  { icon: 'care' as const, title: 'Talk with a medical provider', text: 'Convenient virtual care for many everyday illnesses, medication questions, and ongoing health concerns.' },
  { icon: 'heart' as const, title: 'Start with the right care', text: 'Begin with a virtual conversation to understand whether an office visit, testing, or a specialist is needed.' },
  { icon: 'guide' as const, title: 'Navigate the healthcare system', text: 'Get help finding providers, understanding your options, and coordinating what comes next.' },
  { icon: 'shield' as const, title: 'Make sense of bills and benefits', text: 'Personal support with insurance questions, medical bills, and the questions to ask your health plan.' },
];
const faqs = [
  { question: 'Is this the same as traditional concierge medicine?', answer: 'It offers many of the access and support advantages people associate with concierge medicine, through a virtual subscription model designed to be more accessible and affordable. Exact services depend on the selected program and member eligibility.' },
  { question: 'Can I use the service without health insurance?', answer: 'The service may be valuable for uninsured and underinsured people because it provides access to many virtual-care and navigation services. It is not major medical insurance and does not replace coverage for emergencies, hospitalization, or services received outside the program.' },
  { question: 'Can a virtual doctor prescribe medication?', answer: 'Licensed providers may prescribe clinically appropriate medications when permitted by state law and professional standards. Prescribing is never guaranteed, and some medications cannot be prescribed virtually.' },
  { question: 'Is this for emergencies?', answer: 'No. Call 911 or seek emergency care for life-threatening symptoms. Do not use website forms, email, or routine virtual-care channels during a medical emergency.' },
];
---
<Layout>
  <Header />

  <main id="main">
    <section class="hero container" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-rule"></span> Healthcare, with you at the center</p>
        <h1 id="hero-heading">Concierge healthcare is no longer just <span>for the elite.</span></h1>
        <p class="hero-description">Virtual medical care. A guide through the complicated parts. Personal support for you, your family, and the people who count on you.</p>
        <a class="button" href="#find-your-path">Find your care path</a>
        <a class="quiet-link" href="#how-it-works">See how it works</a>
        <div class="hero-note"><span class="note-mark"><Icon name="check" size={15} /></span><span>Care, navigation, and advocacy. One place to start.</span></div>
      </div>
      <div class="hero-visual">
        <img class="hero-image" src="/images/virtual-care-hero.webp" srcset="/images/virtual-care-hero-small.webp 720w, /images/virtual-care-hero.webp 1440w" sizes="(max-width: 760px) 100vw, 48vw" width="1440" height="960" fetchpriority="high" alt="A woman comfortably using her laptop at home in natural daylight" />
        <div class="image-caption"><span class="caption-icon"><Icon name="heart" size={28} /></span><div><span class="caption-eyebrow">A little less complicated.</span><p>A lot more personal.</p></div></div>
        <span class="visual-accent" aria-hidden="true"></span>
      </div>
    </section>

    <div class="care-strip">
      <div class="container care-strip-inner"><span>Your health. A connected team.</span><div><Icon name="care" />Virtual medical care</div><div><Icon name="guide" />Healthcare navigation</div><div><Icon name="shield" />Patient advocacy</div></div>
    </div>

    <section class="section container paths-section" id="find-your-path" aria-labelledby="paths-heading">
      <div class="section-heading"><div><p class="eyebrow">Care that meets you where you are</p><h2 id="paths-heading">A better place to start.<br />A path for everyone.</h2></div><p>For your workforce, your members, or your family. Find the healthcare support that fits your world.</p></div>
      <div class="path-grid">
        <article class="path-card" id="employers">
          <span class="path-icon"><Icon name="building" size={30} /></span><span class="path-number" aria-hidden="true">01</span>
          <p class="eyebrow">For your workforce</p><h3>Employers</h3><p>Give employees and eligible family members one place to start for medical care, healthcare navigation, and advocacy.</p>
          <ul><li><Icon name="check" size={17} />Easier access to care</li><li><Icon name="check" size={17} />Support for distributed teams</li><li><Icon name="check" size={17} />A more connected benefit</li></ul>
          <a class="path-link" href="/employers">Explore employer solutions</a>
        </article>
        <article class="path-card" id="associations">
          <span class="path-icon"><Icon name="people" size={30} /></span><span class="path-number" aria-hidden="true">02</span>
          <p class="eyebrow">For your community</p><h3>Associations</h3><p>Offer members a practical healthcare resource, especially those who work independently or have limited access to primary care.</p>
          <ul><li><Icon name="check" size={17} />Meaningful member value</li><li><Icon name="check" size={17} />Support wherever work takes them</li><li><Icon name="check" size={17} />Flexible program conversations</li></ul>
          <a class="path-link" href="/associations">Explore association partnerships</a>
        </article>
        <article class="path-card path-card-family" id="individuals">
          <span class="path-icon"><Icon name="heart" size={30} /></span><span class="path-number" aria-hidden="true">03</span>
          <p class="eyebrow">For you and your people</p><h3>Individuals &amp; families</h3><p>Convenient virtual healthcare and a trusted team in your corner when medical or administrative questions arise.</p>
          <ul><li><Icon name="check" size={17} />Help with everyday health needs</li><li><Icon name="check" size={17} />Guidance through the next step</li><li><Icon name="check" size={17} />Personal healthcare support</li></ul>
          <a class="path-link" href="/individuals-and-families">View individual &amp; family access</a>
        </article>
      </div>
      <p class="path-footnote">Healthcare services are provided through Amaze Health and its applicable clinical arrangements.</p>
    </section>

    <section class="support-section" aria-labelledby="support-heading">
      <div class="container support-layout">
        <div class="support-intro"><p class="eyebrow">More than a virtual visit</p><h2 id="support-heading">Healthcare help.<br />Without the <br /><span>usual barriers.</span></h2><p>Healthcare shouldn’t begin with weeks of waiting or uncertainty about whom to call.</p><p>Concierge Health Experts connects people with an Amaze Health solution designed to make care easier to reach—and the system easier to navigate.</p><a class="text-link" href="#how-it-works">Get to know the experience</a></div>
        <div class="service-grid">{services.map((service, i) => <article class="service"><div class="service-top"><Icon name={service.icon} size={31} /><span>0{i + 1}</span></div><h3>{service.title}</h3><p>{service.text}</p></article>)}</div>
      </div>
    </section>

    <section class="section container" id="how-it-works" aria-labelledby="how-heading">
      <div class="how-panel"><div class="how-intro"><p class="eyebrow">One connection. Ongoing support.</p><h2 id="how-heading">A simpler way<br />to move forward.</h2><p>Start with a question. Get help understanding your options. Have someone in your corner for what comes next.</p><a class="button button-light" href="#find-your-path">Find your care path</a></div><ol class="steps"><li><span class="step-number">01</span><div><h3>Find your path</h3><p>Explore options for your organization, yourself, or your family.</p></div></li><li><span class="step-number">02</span><div><h3>Connect with care</h3><p>Eligible members can connect virtually with medical providers and patient advocates through Amaze Health.</p></div></li><li><span class="step-number">03</span><div><h3>Get support beyond the visit</h3><p>Receive guidance with referrals, prescriptions, billing questions, and the next step in your healthcare.</p></div></li></ol></div>
    </section>

    <section class="faq-section container" id="questions" aria-labelledby="faq-heading"><div class="faq-intro"><p class="eyebrow">A little clarity goes a long way</p><h2 id="faq-heading">Good questions.<br />Clear answers.</h2><p>Get to know what virtual concierge healthcare can—and can’t—do for you.</p></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span><Icon name="plus" size={20} /></span></summary><p>{faq.answer}</p></details>)}</div></section>

    <section class="closing-section"><div class="container closing-inner"><p class="eyebrow">Your next step starts here</p><h2>Better healthcare can begin <br />with one simple connection.</h2><p>Choose the path that fits you, your family, your workforce, or your members.</p><div class="closing-actions"><a class="button" href="/employers">For employers</a><a class="button button-outline" href="/associations">For associations</a><a class="button button-outline" href="/individuals-and-families">For individuals &amp; families</a></div></div></section>
  </main>

  <Footer />
</Layout>
