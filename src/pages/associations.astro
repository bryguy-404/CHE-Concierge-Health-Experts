---
import AudienceLayout from '../layouts/AudienceLayout.astro';
import AudienceHero from '../components/AudienceHero.astro';
import AudienceFaqs from '../components/AudienceFaqs.astro';
import CheckList from '../components/CheckList.astro';
import RelatedAudiences from '../components/RelatedAudiences.astro';
import Icon from '../components/Icon.astro';
import { providerLinks } from '../data/site';

const benefits = [
  { title: 'Create everyday member value', text: 'Healthcare access is relevant to nearly every member and can strengthen the practical value of belonging to the organization.' },
  { title: 'Serve mobile and distributed members', text: 'Virtual access is especially valuable for people who travel, work irregular hours, live in rural communities, or cannot easily leave the job site.' },
  { title: 'Support uninsured and underinsured members', text: 'Members can receive help with many routine virtual-care needs and gain guidance navigating outside services. The program does not replace comprehensive medical insurance.' },
  { title: 'Offer a benefit that is easy to explain', text: 'Members get one place to start for a wide range of medical and healthcare-navigation questions instead of another narrow point solution.' },
];
const organizations = [
  'Professional and trade associations',
  'Independent-contractor and gig-worker communities',
  'Trucking, transportation, and logistics organizations',
  'Construction and skilled-trades groups',
  'Outdoor recreation, sports, and enthusiast memberships',
  'Fraternal, alumni, affinity, and community organizations',
  'Groups serving uninsured or underinsured populations',
];
const faqs = [
  { question: 'Is this health insurance?', answer: 'No. The core service provides virtual care, navigation, advocacy, and related support. It does not replace comprehensive medical insurance, emergency coverage, or all services delivered outside the program.' },
  { question: 'Can individual members enroll on their own?', answer: 'Available enrollment models depend on the partnership. An organization may explore a sponsored or group arrangement, while individuals and families may also have access through a separate direct-enrollment pathway.' },
  { question: 'Can an association receive group pricing?', answer: 'Potentially. Group pricing may depend on the association providing one eligibility file and one consolidated form of payment. Amaze must confirm the final requirements and price.' },
  { question: 'What information is needed to explore a partnership?', answer: 'The initial inquiry should include a contact name, email, phone number, organization name, state, and estimated number of members. Amaze’s team can then determine the most appropriate next step.' },
];
---
<AudienceLayout audience="Associations" title="Affordable Concierge Healthcare for Associations and Members" description="Offer members affordable virtual doctors, primary care, healthcare navigation, and advocacy through an association or membership-group healthcare benefit.">
  <AudienceHero eyebrow="For your community" title="Give your members healthcare support they can use from anywhere." description="Bring members an affordable virtual healthcare resource with medical care, prescription support, navigation, and advocacy—without requiring them to leave work, travel long distances, or figure out the system alone." primaryHref={providerLinks.associations} primaryLabel="Explore an association partnership" secondaryHref="#program" secondaryLabel="See how a program works">
    <div class="audience-feature-panel association-panel">
      <div class="panel-heading"><span class="panel-icon"><Icon name="people" size={32} /></span><p class="eyebrow">More value in belonging</p></div>
      <h2>Your community.<br />Connected to care.</h2><p>One clear place to begin, wherever your members’ work and lives take them.</p>
      <ul class="panel-services"><li><Icon name="care" />Virtual medical care</li><li><Icon name="guide" />Help finding the next step</li><li><Icon name="shield" />Personal healthcare advocacy</li></ul>
      <div class="panel-footnote">Program availability and eligibility vary.</div>
    </div>
  </AudienceHero>

  <section class="audience-introduction container" aria-labelledby="member-benefit-title"><p class="eyebrow">A benefit with everyday purpose</p><div class="intro-columns"><h2 id="member-benefit-title">A meaningful benefit for people traditional plans often miss.</h2><div><p>Independent contractors, gig workers, tradespeople, truck drivers, outdoor enthusiasts, and other mobile or self-employed members may not have convenient access to primary care. Some are uninsured. Others have coverage but still struggle with appointments, cost, and fragmented healthcare resources.</p><p>An Amaze Health program can give association members a clear place to begin—whether they need a virtual doctor, help with a prescription, guidance finding a specialist, or support understanding a medical bill.</p></div></div></section>

  <section class="audience-benefits section" aria-labelledby="association-benefits-title"><div class="container"><div class="audience-section-heading"><p class="eyebrow">A practical reason to belong</p><h2 id="association-benefits-title">Why associations offer virtual concierge healthcare.</h2></div><div class="benefit-grid">{benefits.map((benefit, i) => <article><span class="benefit-number">0{i + 1}</span><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}</div></div></section>

  <section class="section container services-layout" aria-labelledby="organizations-title"><div><p class="eyebrow">For many kinds of communities</p><h2 id="organizations-title">Organizations this model may serve.</h2><p>Healthcare access matters across professions, interests, and locations.</p></div><CheckList items={organizations} /></section>

  <section class="program-section" id="program" aria-labelledby="program-title"><div class="container"><div class="program-intro"><p class="eyebrow">A program shaped around your members</p><h2 id="program-title">How an association program can work.</h2><p>Program design depends on the organization and Amaze’s requirements. Amaze will confirm eligibility, pricing, implementation, enrollment, and member-communication requirements during the partnership discussion.</p></div><div class="program-models"><article><span class="path-icon"><Icon name="people" size={29} /></span><p class="eyebrow">An organization-wide benefit</p><h3>Group or sponsored access</h3><p>Explore bringing healthcare support to your membership as a group. Group pricing may be available when an association can provide one eligibility file and one form of payment.</p><a class="text-link" href={providerLinks.associations}>Discuss a group arrangement</a></article><article><span class="path-icon"><Icon name="heart" size={29} /></span><p class="eyebrow">A choice for individual members</p><h3>Individual &amp; family access</h3><p>When members choose to enroll on their own, a separate direct-enrollment pathway and its pricing apply. Available enrollment models depend on the partnership.</p><a class="text-link" href="/individuals-and-families">Explore individual &amp; family access</a></article></div></div></section>

  <AudienceFaqs description="Get to know the partnership options and the information needed to get started." items={faqs} />

  <section class="closing-section audience-closing" id="partnership" aria-labelledby="partnership-title"><div class="container closing-inner"><p class="eyebrow">A meaningful next step for your members</p><h2 id="partnership-title">Explore a healthcare benefit for your members.</h2><p>Give your members a trusted healthcare resource—and give your organization a benefit with immediate, practical value. Share a few details with Amaze’s team to discuss fit, pricing options, and implementation requirements.</p><p class="inquiry-context">Have your contact details, organization name, state, and estimated number of members ready.</p><div class="closing-actions"><a class="button" href={providerLinks.associations}>Explore an association partnership</a></div><p class="destination-note">Continue to Amaze Health to discuss your membership.</p></div></section>
  <RelatedAudiences current="associations" />
</AudienceLayout>
